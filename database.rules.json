                ".validate": "newData.isNumber() && newData.val() >= -1000000 && newData.val() <= 1000000"
              },
              "$other": {
                ".validate": false
              }
            },
            "lagMs": {
              ".validate": "newData.hasChildren(['worse', 'limit']) && (newData.parent().parent().child('test').val() == 'eye' || newData.parent().parent().child('test').val() == 'eyePhone')",
              "worse": {
                ".validate": "(newData.val() == 'higher' || newData.val() == 'lower')"
              },
              "limit": {
                ".validate": "newData.isNumber() && newData.val() >= -1000000 && newData.val() <= 1000000"
              },
              "$other": {
                ".validate": false
              }
            },
            "$other": {
              ".validate": false
            }
          },
          "$other": {
            ".validate": false
          }
        }
      }
    }
  }
}
